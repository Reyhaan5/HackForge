meta {
  name: Get Policy
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/policy
  body: none
  auth: bearer
}

auth:bearer {
  token: {{employeeToken}}
}

tests {
  test("policy read returns active rules", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.have.property("rules");
  });
}
