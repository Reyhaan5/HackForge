vars {
  baseUrl: http://localhost:8000
}

docs {
  # HackForge Backend API

  Bruno requests for every route declared in `Backend/app.py`, including compatibility aliases.
  See `README.md` before running the complete collection: receipt submission, registration,
  policy update, and the reset endpoints write data. The reset routes delete every receipt.
  Run this collection only against a disposable/test database.
}
