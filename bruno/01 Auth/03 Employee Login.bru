meta {
  name: Employee Login
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/login
  body: json
  auth: none
}

body:json {
  {
    "username": "{{employeeUsername}}",
    "password": "{{employeePassword}}"
  }
}

tests {
  test("employee login returns a scoped employee token", function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body.user.role).to.equal("Employee");
    expect(body.user.employee_id).to.equal(bru.getVar("employeeId"));
    bru.setVar("employeeToken", body.token);
  });
}
