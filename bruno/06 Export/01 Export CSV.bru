meta {
  name: Export CSV
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/export-csv
  body: none
  auth: bearer
}

auth:bearer {
  token: {{employeeToken}}
}

tests {
  test("CSV export returns a CSV response", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getHeader("content-type")).to.contain("text/csv");
  });
}
