# 1. Cloud Multimodal Vision (Google Gemini API)
# Get a free API key at: https://aistudio.google.com/app/apikey
# Uses Google's official Gemini vision model (gemini-3.8-flash) via direct REST API
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere123456789

# 2. PostgreSQL Database Connection URL
# Format: postgresql://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/HackForge

# 3. Required API token signing key (keep this secret; do not commit .env)
# Generate a fresh value with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# 4. Base Currency for Company Policy Enforcement
BASE_CURRENCY=USD

# 5. FastAPI Server Host & Port
HOST=0.0.0.0
PORT=8000

# 6. Stage 1 Automated Email Ingestion (Channel A - IMAP / receipts@company.com)
# Optional: Set these if connecting to a real corporate inbox (Gmail, Outlook, custom IMAP)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=receipts@company.com
IMAP_PASSWORD=your_app_password_here
IMAP_FOLDER=INBOX
