# 1. Cloud Multimodal Vision (Google Gemini API)
# Get an API key at: https://aistudio.google.com/app/apikey
# Uses Google's Gemini vision model (gemini-2.5-flash / gemini-1.5-flash)
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere123456789
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-1.5-flash

# 2. PostgreSQL Database Connection URL
# Format: postgresql://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/HackForge

# 3. Required API token signing key (keep this secret; do not commit .env)
# Generate a fresh value with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=your_super_secret_jwt_key_here

# 4. Base Currency for Company Policy Enforcement
BASE_CURRENCY=INR

# 5. FastAPI Server Host & Port
HOST=0.0.0.0
PORT=8000

# 6. Stage 1 Automated Email Ingestion (Channel A - IMAP / receipts@company.com)
# Connects to corporate inbox (Gmail with 16-character App Password, Outlook, or custom IMAP)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=receipts@company.com
IMAP_PASSWORD=your_email_app_password_here
IMAP_FOLDER=INBOX

# 7. Stage 1 Automated AWS S3 Cloud Storage Ingestion (Channel B)
# Target S3 bucket where desktop sync, corporate scanners, or mobile apps drop receipts
AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_REGION=ap-southeast-2
S3_BUCKET_NAME=your-expense-vault-bucket-name
S3_INBOX_PREFIX=inbox/

# 8. Desktop Auto-Sync Folder (Optional default for local sync agent)
DEFAULT_EMPLOYEE_ID=EMP-101

